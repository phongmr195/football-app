PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_app?schema=public"

# Production: set 1 trong 2
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Local dev: dùng Firebase Auth Emulator, không cần project thật
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

AWS_REGION=ap-southeast-1

# Cache cho GET /matches/live (TTL 5s) — optional, không set thì tự fallback thẳng Postgres, không lỗi.
REDIS_URL=redis://localhost:6379

# Ký/verify JWT cho admin session (apps/api/src/middleware/admin-auth.ts) — hoàn toàn tách biệt
# khỏi Firebase (User thường). Set 1 chuỗi random dài thật trong .env/.env.local, ví dụ:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=
