DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_app?schema=public"

# API-Football (RapidAPI) — xem PROJECT_PLAN.md § Data Provider. Chưa có key thật (ROADMAP).
API_FOOTBALL_KEY=

# SYNC_MODE=live (mặc định, syncLiveMatches) | catalog (syncAll — competitions/teams/players/standings/matches)
SYNC_MODE=live

# Chỉ cần khi SYNC_MODE=catalog — external ID (API-Football) của các giải cần sync, phân
# tách bằng dấu phẩy, ví dụ "39,140" (Premier League, La Liga). Chưa verify ID thật.
SYNC_COMPETITION_IDS=
SYNC_SEASON_YEAR=

# Redis Pub/Sub cho real-time push (Phase 2 Bước 2, xem CLAUDE.md § Data provider / packages/
# realtime) — optional: không set thì publish() no-op (không lỗi), sync-worker vẫn chạy bình
# thường, chỉ apps/api không nhận được push (client fallback về safety-net poll).
# REDIS_URL=redis://localhost:6379
