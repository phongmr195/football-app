# Base URL for apps/api (Hono REST backend). Server-only (no NEXT_PUBLIC_ prefix) —
# used by Server Components / lib/api-client.ts. See apps/api/src/index.ts (PORT, default
# 3000) and docker-compose.yml's "api" service (host port mapping 3000:3000).
API_URL=http://localhost:3000

# Firebase Web app SDK config — project jankara-e2e-test (shared with other apps, see
# CLAUDE.md "Authentication"). These are Firebase *client* config values, public by
# design (not traditional secrets — see PROJECT_PLAN.md), but the app registration itself
# isn't committed here since the project is shared. Get your own copy with:
#   firebase apps:sdkconfig WEB <your-web-app-id> --project jankara-e2e-test
# (run `firebase apps:list --project jankara-e2e-test` first if you don't have the app id)
# then copy this file to .env.local and fill in the real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base URL for apps/api reachable from the browser. Needs the NEXT_PUBLIC_ prefix (unlike
# API_URL above) because Client Components (e.g. the favorites feature) call apps/api
# directly from the browser via lib/api-client.ts (apiGetClient/apiMutateClient) — Next.js
# only exposes env vars with this prefix to client-side code. Same backend as API_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Web Push (Phase 2 Bước 3, FCM) — tạo tay tại Firebase Console: Project Settings > Cloud
# Messaging > Web configuration > Generate key pair. Không có key này thì getToken() trong
# lib/push-notifications.ts sẽ lỗi (không chặn build/typecheck, chỉ chặn push thật hoạt động).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BLYj9Ox9Cew0MMeqSfTwOr6buEL6DCebhydryqTNVD6zZ6aHVS0mq4nQYDlu7pJNY2yEQi4Wmcg-9rjHx1ZXP6E
