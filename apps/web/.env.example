# Base URL for apps/api (Hono REST backend). Server-only (no NEXT_PUBLIC_ prefix) —
# used by Server Components / lib/api-client.ts. See apps/api/src/index.ts (PORT, default
# 3000) and docker-compose.yml's "api" service (host port mapping 3000:3000).
API_URL=http://localhost:3000

# Firebase Web app SDK config — project jankara-e2e-test (shared with other apps, see
# CLAUDE.md "Authentication"). These are Firebase *client* config values, public by
# design (not traditional secrets — see PROJECT_PLAN.md), but the app registration itself
# isn't committed here since the project is shared. Get your own copy with:
#   firebase apps:sdkconfig WEB <your-web-app-id> --project jankara-e2e-test
# (run `firebase apps:list --project jankara-e2e-test` first if you don't have the app id)
# then copy this file to .env.local and fill in the real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
