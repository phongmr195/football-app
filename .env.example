# Biến cho docker-compose.yml — copy thành .env (docker compose tự đọc), không cần export tay.
# Không cần set FIREBASE_PROJECT_ID/FIREBASE_AUTH_EMULATOR_HOST nếu chỉ test qua Auth Emulator
# (docker-compose.yml đã default sẵn tới service firebase-emulator).

# API-Football (RapidAPI) — cần cho sync-worker gọi dữ liệu thật, xem PROJECT_PLAN.md § Data Provider
API_FOOTBALL_KEY=

# Chỉ set khi muốn api container verify token từ Firebase project THẬT (không phải emulator)
# FIREBASE_PROJECT_ID=jankara-e2e-test
# FIREBASE_AUTH_EMULATOR_HOST=
